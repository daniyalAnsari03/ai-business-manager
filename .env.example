# Supabase — Project Settings → API
# These two are PUBLIC values (safe for the browser).
# NEVER add the service-role/secret key to this file or any client-side code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# OPTIONAL — Supabase SERVICE ROLE key (server-side ONLY). Used ONLY for the
# deliberate, isolated ADMIN operation that must span every business: the
# global marketing-draft backfill (docs/phase0.txt). It bypasses RLS, so never
# expose it to the client and never put a real value in this example file. When
# absent, the global backfill refuses with no_service_role and only the
# per-account (session-scoped) backfill remains available.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email confirmation also requires dashboard setup (Authentication → URL
# Configuration): Site URL + Redirect URLs must include http://localhost:3001/**
# for local development. See docs/supabase-auth-local.md.

# ---------------------------------------------------------------------------
# OpenAI (PRIMARY AI provider) — SERVER-SIDE ONLY. Never expose to the
# client.
#
# Get a key at https://platform.openai.com/api_keys. Leave empty to
# skip OpenAI and fall back to Gemini+Groq as the primary chain.
OPENAI_API_KEY=your-openai-api-key

# Primary model. Do not silently change this; if the configured model is
# unavailable on OpenAI the error is reported and the backup chain engages.
OPENAI_MODEL=gpt-5.6-luna

# ---------------------------------------------------------------------------
# Gemini (BACKUP AI provider #1) — SERVER-SIDE ONLY. Never expose to the
# client.
#
# Engaged automatically when OpenAI fails (rate-limited/auth/unavailable).
# Add one or more Google AI Studio keys (https://aistudio.google.com/apikey).
# Every request automatically fails over to the next key when a key is
# rate-limited (429), rejected (401/403), or the upstream call errors out —
# so several free-tier keys can be combined into one reliable pool.
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=

# Optional overrides
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ---------------------------------------------------------------------------
# Groq (BACKUP AI provider #2 — final fallback) — SERVER-SIDE ONLY. Never
# expose to the client.
#
# Used automatically ONLY when both OpenAI and the full Gemini chain fail
# (quota/auth/outage). Get a free key at https://console.groq.com/keys.
# Leave empty to disable the final backup entirely.
GROQ_API_KEY=your-groq-api-key

# Backup model. Do not silently change this; if the configured model is
# unavailable on Groq the error is reported instead of switching models.
GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Meta (Facebook / Instagram) — SERVER-SIDE ONLY. Never expose to the client.
#
# Used only for the real Instagram/Facebook OAuth connect flow (Marketing
# settings → Connect). Create an app in Meta's developer portal, add the
# Products "Facebook Login for Business" AND "Instagram > API setup with
# Instagram login" and configure:
#   * App Domains: your-public-domain
#   * Facebook Login → Valid OAuth Redirect URIs:
#       http://localhost:3001/api/marketing/oauth/callback
#       https://your-app.example/api/marketing/oauth/callback
#   * Instagram → Business login settings → OAuth redirect URIs:
#       http://localhost:3001/api/marketing/oauth/callback
#       https://your-app.example/api/marketing/oauth/callback
# (Port 3001 is this project's standard local dev port — see package.json
# `dev` script. The value registered here must match the redirect_uri the app
# sends, which the app derives from the request host unless META_OAUTH_REDIRECT_URL
# is set below.)
#
# IMPORTANT: A single Meta app has MULTIPLE App IDs:
#   - META_APP_ID: the main Meta App ID (found at top of App Dashboard)
#     Used for Facebook Login (facebook.com/dialog/oauth).
#   - META_INSTAGRAM_APP_ID: the Instagram App ID (found in App Dashboard
#     → Instagram → API setup with Instagram login → Business login settings
#     → Instagram App ID). Used for Instagram Login (instagram.com/oauth/authorize).
#     These are DIFFERENT IDs — using the wrong one causes "Invalid platform app".
#
# Instagram Login scopes (requested through instagram.com/oauth/authorize):
#   instagram_business_basic, instagram_business_content_publish
# Facebook Login scopes (requested through facebook.com/dialog/oauth):
#   pages_show_list, pages_read_engagement, business_management
# When META_FACEBOOK_CONFIG_ID is set, config_id replaces scope entirely.
#
# When these are absent the Connect button for Instagram/Facebook refuses
# honestly (no fake connection is ever saved).
# META_APP_ID=your-meta-app-id
# META_APP_SECRET=your-meta-app-secret
#
# REQUIRED for Instagram OAuth — the Instagram App ID and Secret from
# App Dashboard → Instagram → API setup with Instagram login → Business login
# settings. These are SEPARATE from META_APP_ID/META_APP_SECRET.
# META_INSTAGRAM_APP_ID=your-instagram-app-id
# META_INSTAGRAM_APP_SECRET=your-instagram-app-secret
#
# OPTIONAL — Facebook Login for Business Configuration ID.
# Found in Meta App Dashboard → Facebook Login for Business → Configurations.
# When set, the Facebook OAuth dialog uses `config_id` instead of `scope`,
# which is the official Meta approach for Facebook Login for Business.
# This resolves the "Invalid Scopes: pages_manage_posts" error because the
# Configuration ID controls which permissions are requested.
# META_FACEBOOK_CONFIG_ID=your-configuration-id
#
# OPTIONAL — pin the exact OAuth callback origin so the redirect_uri Meta sees
# is deterministic and identical across localhost/LAN/deployment hosts. When
# set, this value (or this + "/api/marketing/oauth/callback") MUST exactly
# match a "Valid OAuth Redirect URIs" entry in the Meta App Dashboard.
# META_OAUTH_REDIRECT_URL=https://your-app.example

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (OPTIONAL — Meta, free-to-start) — SERVER-SIDE ONLY.
# Never expose to the client. When these are absent the approval flow degrades
# honestly: actions are still created and reviewable in-app, but no WhatsApp
# approval messages or weekly reports are sent (nothing fake is delivered).
#
# 1. Create an app and a WhatsApp business number in Meta's developer portal.
# 2. Get a long-lived access token for the WhatsApp Cloud API.
# 3. WHATSAPP_PHONE_NUMBER_ID identifies the sender phone number.
# 4. WHATSAPP_VERIFY_TOKEN is your own random string used to verify the
#    webhook URL on first setup (must match what you enter in Meta).
# 5. WHATSAPP_APP_SECRET is the app secret used to verify webhook signatures.
#
# The webhook must be configured in Meta as:
#   https://your-app.example/api/whatsapp/webhook
# with the subscribe field `messages`.
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-whatsapp-app-secret

# ---------------------------------------------------------------------------
# Weekly report scheduler (OPTIONAL) — SERVER-SIDE ONLY.
#
# The weekly marketing report is generated by an external cron hitting
# `/api/cron/weekly-report`. Protect that endpoint with a secret token; when
# set, requests without `x-cron-secret: <CRON_SECRET>` are rejected with 401.
# When BOTH CRON_SECRET and CRON_AUTH_TOKEN are absent no auth is required
# (suitable only for isolated/private deployments).
CRON_SECRET=your-cron-secret
# CRON_AUTH_TOKEN=your-cron-secret-alias
