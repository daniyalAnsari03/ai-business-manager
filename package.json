{
  "name": "ai-business-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:ngrok": "pwsh scripts/dev-ngrok.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:failover": "node --conditions=react-server --import ./tests/ai/register-hooks.mjs tests/ai/failover-matrix.mjs",
    "test:failover-consecutive": "node --conditions=react-server --import ./tests/ai/register-hooks.mjs tests/ai/consecutive-requests.mjs",
    "test:tools": "node --conditions=react-server --import ./tests/ai/register-hooks.mjs tests/ai/business-tools.mjs",
    "test:audit": "node --conditions=react-server --import ./tests/ai/register-audit-hooks.mjs tests/ai/audit-log-tools.mjs",
    "test:type-config": "node --conditions=react-server --import ./tests/ai/register-hooks.mjs tests/business/type-config.test.mjs",
    "test:product-attributes": "node --conditions=react-server --import ./tests/ai/register-hooks.mjs tests/business/product-attributes.test.mjs",
    "test:product-units": "node --conditions=react-server --import ./tests/ai/register-hooks.mjs tests/business/product-units.test.mjs",
    "test:product-service": "node --conditions=react-server --import ./tests/products/register-service-hooks.mjs tests/products/product-service-extras.mjs",
    "test:attribute-form": "node --conditions=react-server --import ./tests/ai/register-hooks.mjs tests/products/attribute-form.test.mjs",
    "test:agent-instructions": "node --conditions=react-server --import ./tests/ai/register-hooks.mjs tests/ai/agent-instructions.mjs",
    "test:budget-planner": "node --conditions=react-server --import ./tests/ai/register-hooks.mjs tests/marketing/ad-budget-planner.test.mjs",
    "test:ad-campaign-tool": "node --conditions=react-server --import ./tests/marketing/register-ad-campaign-hooks.mjs tests/marketing/ad-campaign-tool.test.mjs",
    "test:meta-oauth": "node --conditions=react-server --import ./tests/ai/register-hooks.mjs tests/marketing/meta-oauth-discover.test.mjs",
    "test:payments-service": "node --conditions=react-server --import ./tests/payments/register-hooks.mjs tests/payments/payments-service.test.mjs",
    "test:suppliers-service": "node --conditions=react-server --import ./tests/payments/register-hooks.mjs tests/suppliers/service.test.mjs",
    "test:payment-tools": "node --conditions=react-server --import ./tests/payments/register-tools-hooks.mjs tests/payments/payment-tools.test.mjs",
    "test:payment-ui": "node --conditions=react-server --import ./tests/payments/register-hooks.mjs tests/payments/ui-helpers.test.mjs",
    "test:payments": "npm run test:payments-service && npm run test:suppliers-service && npm run test:payment-tools && npm run test:payment-ui",
    "perf:audit": "node --env-file=.env.local tests/qa/perf-audit.mjs"
  },
  "dependencies": {
    "@openai/agents": "^0.17.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "framer-motion": "^12.15.0",
    "next": "^15.3.3",
    "openai": "^7.5.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3"
  }
}
